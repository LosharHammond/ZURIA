# ── Firebase Client (public — safe to expose in the browser) ──────────────────
# From Firebase console → Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# ── Firebase Admin SDK (secret — server-side only, NEVER expose to browser) ───
# From Firebase console → Project Settings → Service Accounts → Generate new private key
# FIREBASE_PROJECT_ID is optional — falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# Wrap it in double quotes if it contains newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# From console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your approved WhatsApp sender number (format: whatsapp:+233XXXXXXXXX)
# For sandbox testing use: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# The same number WITHOUT the "whatsapp:" prefix and WITHOUT the "+" sign
# Users will open: https://wa.me/233XXXXXXXXX
# Example: 233242176603 (for +233 24 217 6603)
NEXT_PUBLIC_WA_NUMBER=

# ── Admin ─────────────────────────────────────────────────────────────────────
# The phone number that can access the /admin panel (with country code, e.g. +233241234567)
# Must match the Firebase phone number used to sign in as admin
NEXT_PUBLIC_ADMIN_PHONE=233557
# Server-side copy of the same number (used in /api/admin/* route protection)
ADMIN_PHONE=
# MoMo number users send subscription payments to.
# Defaults to ADMIN_PHONE if not set separately.
# Format: local (0XXXXXXXXX) or international (233XXXXXXXXX)
ADMIN_MOMO_NUMBER=
# WhatsApp support number in international format without "+" (derived from ADMIN_MOMO_NUMBER if omitted)
# Example: 233242176603
SUPPORT_WA_NUMBER=

# ── Paystack (required for subscriptions + automated MoMo payouts) ──────────
# From dashboard.paystack.com → Settings → API Keys
# Secret key is server-only — NEVER expose to the browser
PAYSTACK_SECRET_KEY=sk_live_...
# Public key is safe to expose to the browser (used for client-side Paystack.js if needed)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
# Webhook secret — optional but recommended. Set under Paystack → Settings → Webhooks.
# Set your webhook URL to: https://your-domain.com/api/payments/webhook
# Also enable: Settings → Transfers → Automation (for auto MoMo payouts)
PAYSTACK_WEBHOOK_URL=https://zuria.app/api/payments/webhook

# ── App URL (used for Open Graph / social sharing previews) ──────────────────
# Your production domain — no trailing slash
# Example: https://zuria.app  or  https://zuria.vercel.app
NEXT_PUBLIC_APP_URL=https://zuria.vercel.app

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# From @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=
# Optional secret token to verify incoming webhook requests from Telegram.
# Generate any random string (e.g. openssl rand -hex 32) and set the same
# value when registering the webhook:
#   curl -X POST https://api.telegram.org/bot{TOKEN}/setWebhook \
#        -d "url=https://YOUR_DOMAIN/api/telegram/webhook" \
#        -d "secret_token=YOUR_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=
# Public username of your Telegram bot (without the @). Used for CTA links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ZuriaBot

# ── Development only ──────────────────────────────────────────────────────────
# Set to "true" to enable the /api/whatsapp/debug endpoint in development
# NEVER set this in production — leave blank or omit entirely
ENABLE_DEBUG_ENDPOINT=
