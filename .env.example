# ══════════════════════════════════════════════════════════════════════════════
# ZURIA — Environment Variables Reference
#
# Copy this file to .env.local for local development.
# Set all variables in your hosting platform (Vercel) for production.
#
# NEVER commit .env.local to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Firebase Client (public — safe to expose in the browser) ──────────────────
# From Firebase console → Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (secret — server-side only, NEVER expose to browser) ───
# From Firebase console → Project Settings → Service Accounts → Generate new private key
# FIREBASE_PROJECT_ID is optional — falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# Wrap it in double quotes if it contains newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Security secrets (required in production) ─────────────────────────────────
# Session cookie signing secret — REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=

# Cron job authentication secret — REQUIRED in production.
# In Vercel: Settings → Environment Variables → add CRON_SECRET, then use the same value
# in vercel.json (Vercel also injects it automatically for cron invocations).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CRON_SECRET=

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# From console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your approved WhatsApp sender number (format: whatsapp:+233XXXXXXXXX)
# For sandbox testing use: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# The same number WITHOUT the "whatsapp:" prefix and WITHOUT the "+" sign
# Users will open: https://wa.me/233XXXXXXXXX
# Example: 233242176603 (for +233 24 217 6603)
NEXT_PUBLIC_WA_NUMBER=

# ── Admin ─────────────────────────────────────────────────────────────────────
# The phone number that can access the /admin panel (with country code, e.g. +233241234567)
# Must match the Firebase phone number used to sign in as admin
NEXT_PUBLIC_ADMIN_PHONE=
# Server-side copy of the same number (used in /api/admin/* route protection)
ADMIN_PHONE=
# MoMo number users send subscription payments to.
# Defaults to ADMIN_PHONE if not set separately.
# Format: local (0XXXXXXXXX) or international (233XXXXXXXXX)
ADMIN_MOMO_NUMBER=
# WhatsApp support number in international format without "+" (derived from ADMIN_MOMO_NUMBER if omitted)
# Example: 233242176603
SUPPORT_WA_NUMBER=

# ── Paystack (required for subscriptions + automated MoMo payouts) ───────────
# From dashboard.paystack.com → Settings → API Keys
# Secret key is server-only — NEVER expose to the browser
PAYSTACK_SECRET_KEY=sk_live_...
# Public key is safe to expose to the browser (used for client-side Paystack.js if needed)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
# Webhook secret — optional but recommended. Set under Paystack → Settings → Webhooks.
# Set your webhook URL to: https://your-domain.com/api/payments/webhook
# Also enable: Settings → Transfers → Automation (for auto MoMo payouts)
PAYSTACK_WEBHOOK_URL=https://zuria.app/api/payments/webhook

# ── App URL (used for Open Graph / social sharing previews) ──────────────────
# Your production domain — no trailing slash
# Example: https://zuria.app  or  https://zuria.vercel.app
NEXT_PUBLIC_APP_URL=https://zuria.vercel.app

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# From @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=
# Optional secret token to verify incoming webhook requests from Telegram.
# Generate any random string (e.g. openssl rand -hex 32) and set the same
# value when registering the webhook:
#   curl -X POST https://api.telegram.org/bot{TOKEN}/setWebhook \
#        -d "url=https://YOUR_DOMAIN/api/telegram/webhook" \
#        -d "secret_token=YOUR_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=
# Public username of your Telegram bot (without the @). Used for CTA links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ZuriaBot

# ── Groq AI (required for AI-powered responses — app degrades gracefully without) ──
# From console.groq.com → API Keys → Create API Key
# Powers: transaction understanding, executive reports, business coaching, shadow learning
# Models used: llama-3.1-8b-instant (fast), deepseek-r1-distill-llama-70b (advanced),
#              meta-llama/llama-prompt-guard-2-22m (safety guard)
GROQ_API_KEY=gsk_...

# ── OpenAI (optional — fallback AI provider if Groq is unavailable) ──────────
# From platform.openai.com → API keys
# WARNING: Adds per-message API cost. Groq is preferred (cheaper + faster).
OPENAI_API_KEY=

# ── AI Feature Toggles ────────────────────────────────────────────────────────
# Set to "false" to disable specific AI systems without a code deploy.
# All default to "true" (enabled) if not set.

# Master AI switch — set to "false" to disable ALL AI and fall back to rule-based engine
AI_ENABLED=true

# Fast model (llama-3.1-8b-instant) — used for medium-confidence extractions
AI_FAST_ENABLED=true

# Advanced model (deepseek-r1-distill-llama-70b) — used for low-confidence and reports
AI_ADVANCED_ENABLED=true

# Safety guard model (llama-prompt-guard-2-22m) — screens for prompt injection
AI_GUARD_ENABLED=true

# ── Shadow Learning Configuration ────────────────────────────────────────────
# Shadow learning silently compares parser output to AI output for training data.
# Set to "false" to disable entirely.
AI_SHADOW_LEARNING=true

# Probability (0.0–1.0) of shadow-sampling a high-confidence message.
# Default: 0.10 (10%). Lower to reduce AI costs, raise for faster learning.
SHADOW_SAMPLE_RATE=0.10

# ── AI Cost Governance ────────────────────────────────────────────────────────
# Per-user daily AI spend budget in USD. Default: $0.50
# Set lower to reduce costs; set to a high value to remove limits.
DAILY_AI_BUDGET_USD=0.50

# ── Sentry Observability ──────────────────────────────────────────────────────
# From sentry.io → Settings → Projects → Client Keys (DSN)
# Tracks: parser failures, AI failures, webhook errors, Firebase errors,
#         payment failures, queue failures, unhandled exceptions.
# Custom tags: userId, businessId, parserConfidence, AIModel, platform, subscriptionTier
#
# Server-side DSN (not exposed to browser)
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
# Client-side DSN (safe to expose — Sentry client-side uses this)
NEXT_PUBLIC_SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
# Auth token for source map uploads (generate at sentry.io → Settings → Auth Tokens)
# Only needed in CI/CD pipelines. NEVER set this in .env.local.
SENTRY_AUTH_TOKEN=
# Sentry organization slug (from sentry.io → Settings → Organization)
SENTRY_ORG=your-org-slug
# Sentry project slug (from sentry.io → Settings → Projects)
SENTRY_PROJECT=zuria

# ── Upstash Redis (optional — required for distributed rate limiting in production) ─
# The built-in in-memory rate limiter does NOT work in serverless/multi-instance.
# To enable proper distributed rate limiting, create a free database at upstash.com
# and set these values. See lib/rate-limit.ts for integration instructions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── WhatsApp sandbox mode (optional — development only) ───────────────────────
# Set to "true" when using Twilio WhatsApp sandbox during development.
# Controls sandbox-specific message wording. Leave blank in production.
WHATSAPP_SANDBOX=

# ── Development only ──────────────────────────────────────────────────────────
# Set to "true" to enable the /api/whatsapp/debug endpoint in development
# NEVER set this in production — leave blank or omit entirely
ENABLE_DEBUG_ENDPOINT=
