{
  "name": "zuria",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --no-coverage",
    "test:regression": "jest 16-behavioral-regression --no-coverage",
    "test:guard": "jest regression-guard --no-coverage",
    "test:all": "jest --no-coverage",
    "project:guard": "node scripts/project-guard.mjs",
    "project:update-baseline": "node scripts/update-project-baseline.mjs",
    "regression:update-baseline": "node scripts/update-baseline.mjs",
    "regression:install-hooks": "node -e \"require('os').platform()==='win32' ? require('child_process').execSync('powershell -ExecutionPolicy Bypass -File scripts/install-hooks.ps1',{stdio:'inherit'}) : require('child_process').execSync('bash scripts/install-hooks.sh',{stdio:'inherit'})\"",
    "prepare": "node -e \"try{require('child_process').execSync(require('os').platform()==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/install-hooks.ps1':'bash scripts/install-hooks.sh',{stdio:'inherit'})}catch(e){console.warn('Hook install skipped (no git):',e.message)}\""
  },
  "dependencies": {
